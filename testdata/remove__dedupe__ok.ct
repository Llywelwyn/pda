$ pda set foo 1
$ pda set bar 2
$ pda ls
 a           echo hello   
                          
 a1          1            
 a2          2            
 b1          3            
 bar         2            
 copied-key  hidden-value 
 foo         1            
 moved-key   hidden-value
$ pda rm foo --glob "*"
$ pda get bar --> FAIL
FAIL  cannot get 'bar': no such key
$ pda get foo --> FAIL
FAIL  cannot get 'foo': no such key
