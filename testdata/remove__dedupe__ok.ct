$ pda set foo 1
$ pda set bar 2
$ pda ls
 a    echo hello 
                 
 a1   1          
 a2   2          
 b1   3          
 bar  2          
 foo  1
$ pda rm foo --glob "*"
$ pda get bar --> FAIL
Error: cannot get 'bar': No such key
$ pda get foo --> FAIL
Error: cannot get 'foo': No such key
